# Template. Copy to .env (same folder) and fill in. .env is never committed to Git.

# Public address, without trailing slash. Empty = the address the site is opened with.
SITE_URL=

# Database (XAMPP: user root without password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=elias
DB_USER=root
DB_PASS=
# Only for XAMPP: create the database and tables automatically.
DB_CREATE_IF_MISSING=true

# Ask Elias (OpenRouter)
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini
AI_DAILY_LIMIT=400

# Admin password as a hash (see README: "Admin-Passwort")
ADMIN_PASSWORD_HASH=

# Random text for hashing visitor IP addresses
IP_SALT=

TRUST_FORWARDED_FOR=false
